rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public-read content. Soft-delete via is_active is enforced client-side
    // so the offline cache can include inactive rows; security is "read-only,
    // no writes from clients."
    match /questions/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /states/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /license_types/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /assessment_types/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /question_sets/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /question_set_categories/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /state_resources/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
